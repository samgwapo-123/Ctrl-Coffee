@page "/cart"
@inject CartService Cart
@inject BookingService Booking

<PageTitle>Cart – Byte &amp; Brew</PageTitle>

<h1 class="text-4xl font-black tracking-tight text-ink">
    Your <span class="font-serif font-normal italic text-copper">cart</span>
</h1>

@if (orderPlaced)
{
    <div class="mt-8 animate-fade-up rounded-3xl border border-ink/10 bg-white p-10 text-center">
        <div class="text-6xl">🎉</div>
        <h2 class="mt-4 text-2xl font-black">Thank you, @orderName!</h2>
        <p class="mt-2 text-ink/70">
            Your order total of <span class="font-bold text-copper">₱@orderTotal.ToString("N2")</span> has been placed.
        </p>
        <a href="/cafe" class="mt-6 inline-block rounded-full bg-ink px-6 py-3 text-sm font-bold text-cream transition hover:bg-copper">Keep shopping</a>
    </div>
}
else if (!Cart.Items.Any())
{
    <div class="mt-8 animate-fade-up rounded-3xl border border-ink/10 bg-white p-10 text-center">
        <div class="text-6xl">🛒</div>
        <p class="mt-4 text-ink/70">Your cart is empty.</p>
        <div class="mt-5 flex flex-wrap justify-center gap-3">
            <a href="/cafe" class="rounded-full bg-ink px-6 py-3 text-sm font-bold text-cream transition hover:bg-copper">Browse the café</a>
            <a href="/gadgets" class="rounded-full border border-ink/20 px-6 py-3 text-sm font-bold transition hover:bg-white">Browse gadgets</a>
        </div>
    </div>
}
else
{
    <div class="mt-8 grid gap-8 lg:grid-cols-3">
        <div class="space-y-4 lg:col-span-2">
            @foreach (var item in Cart.Items)
            {
                <div class="flex flex-wrap items-center gap-4 rounded-2xl border border-ink/10 bg-white p-4 animate-fade-up">
                    <div class="relative flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-xl bg-cream text-3xl">
                        @item.Product.Emoji
                        <img src="@item.Product.ImagePath" alt="@item.Product.Name" onerror="this.style.display='none'"
                             class="absolute inset-0 h-full w-full bg-cream object-cover" />
                    </div>

                    <div class="min-w-32 flex-1">
                        <p class="font-bold">@item.Product.Name</p>
                        <p class="text-sm text-ink/60">@item.Product.PriceText each</p>
                    </div>

                    <div class="flex items-center gap-1 rounded-full border border-ink/15 p-1">
                        <button @onclick="() => Cart.Decrease(item.Product.Id)" class="h-8 w-8 rounded-full transition hover:bg-cream active:scale-90" aria-label="Decrease quantity">−</button>
                        <span class="w-6 text-center text-sm font-bold">@item.Quantity</span>
                        <button @onclick="() => Cart.Increase(item.Product.Id)" class="h-8 w-8 rounded-full transition hover:bg-cream active:scale-90" aria-label="Increase quantity">+</button>
                    </div>

                    <p class="w-24 text-right font-black text-ink">₱@item.LineTotal.ToString("N2")</p>
                    <button @onclick="() => Cart.Remove(item.Product.Id)" class="text-sm text-red-600 hover:underline">Remove</button>
                </div>
            }
        </div>

        <div class="h-fit rounded-2xl border border-ink/10 bg-white p-6 lg:sticky lg:top-28">
            <h2 class="text-xl font-black">Order summary</h2>
            <div class="mt-4 flex justify-between text-sm text-ink/70"><span>Items</span><span>@Cart.Count</span></div>
            <div class="mt-2 flex justify-between text-lg font-black">
                <span>Total</span><span class="text-copper">₱@Cart.Total.ToString("N2")</span>
            </div>

            @if (Booking.Latest is { } b)
            {
                <p class="mt-4 rounded-xl bg-cream p-3 text-sm">
                    ☕ We'll have your order ready for your repair on <b>@b.Date.ToString("MMM d")</b> at <b>@b.TimeSlot</b>.
                </p>
            }

            <EditForm Model="model" OnValidSubmit="PlaceOrder" class="mt-6 space-y-3">
                <DataAnnotationsValidator />
                <div>
                    <label class="block text-sm font-medium">Name</label>
                    <InputText @bind-Value="model.Name" class="@field" />
                    <ValidationMessage For="() => model.Name" class="text-sm text-red-600" />
                </div>
                <div>
                    <label class="block text-sm font-medium">Contact number</label>
                    <InputText @bind-Value="model.Contact" class="@field" />
                    <ValidationMessage For="() => model.Contact" class="text-sm text-red-600" />
                </div>
                <button type="submit" class="w-full rounded-full bg-ink py-3 text-sm font-bold text-cream transition hover:bg-copper active:scale-95">Place order</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private const string field = "w-full rounded-lg border border-forest/30 px-3 py-2 transition focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/20";

    private CheckoutModel model = new();
    private bool orderPlaced;
    private string orderName = "";
    private decimal orderTotal;

    private void PlaceOrder()
    {
        orderName = model.Name;
        orderTotal = Cart.Total;
        Cart.Clear();
        orderPlaced = true;
    }
}