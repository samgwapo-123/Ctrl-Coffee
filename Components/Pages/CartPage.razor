@page "/cart"
@using System.ComponentModel.DataAnnotations
@inject CartService Cart
@inject BookingService Booking

<PageTitle>Cart – Byte &amp; Brew</PageTitle>

<h1 class="text-3xl font-bold">Your Cart</h1>

@if (orderPlaced)
{
    <div class="mt-8 bg-white rounded-xl shadow p-8 text-center">
        <div class="text-6xl">🎉</div>
        <h2 class="mt-4 text-2xl font-bold">Thank you, @orderName!</h2>
        <p class="mt-2">Your order total of <span class="font-bold text-copper">₱@orderTotal.ToString("N2")</span> has been placed.</p>
        <a href="/cafe" class="inline-block mt-6 bg-forest text-cream px-6 py-2 rounded-full font-semibold hover:opacity-90">Keep shopping</a>
    </div>
}
else if (!Cart.Items.Any())
{
    <div class="mt-8 bg-white rounded-xl shadow p-8 text-center">
        <div class="text-6xl">🛒</div>
        <p class="mt-4">Your cart is empty.</p>
        <a href="/cafe" class="inline-block mt-4 bg-copper text-white px-6 py-2 rounded-full font-semibold hover:opacity-90">Go to shop</a>
    </div>
}
else
{
    <div class="mt-6 grid gap-8 lg:grid-cols-3">
        <div class="lg:col-span-2 space-y-4">
            @foreach (var item in Cart.Items)
            {
                <div class="bg-white rounded-xl shadow p-4 flex flex-wrap items-center gap-4">
                    <div class="text-4xl">@item.Product.Emoji</div>
                    <div class="flex-1 min-w-32">
                        <p class="font-semibold">@item.Product.Name</p>
                        <p class="text-sm text-forest/70">@item.Product.PriceText each</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button @onclick="() => Cart.Decrease(item.Product.Id)" class="w-8 h-8 rounded-full border border-forest hover:bg-forest/10">−</button>
                        <span class="w-6 text-center font-semibold">@item.Quantity</span>
                        <button @onclick="() => Cart.Increase(item.Product.Id)" class="w-8 h-8 rounded-full border border-forest hover:bg-forest/10">+</button>
                    </div>
                    <p class="w-24 text-right font-bold text-copper">₱@item.LineTotal.ToString("N2")</p>
                    <button @onclick="() => Cart.Remove(item.Product.Id)" class="text-sm text-red-600 hover:underline">Remove</button>
                </div>
            }
        </div>

        <div class="bg-white rounded-xl shadow p-6 h-fit">
            <h2 class="text-xl font-bold">Order Summary</h2>
            <div class="mt-3 flex justify-between"><span>Items</span><span>@Cart.Count</span></div>
            <div class="mt-1 flex justify-between text-lg font-bold">
                <span>Total</span><span class="text-copper">₱@Cart.Total.ToString("N2")</span>
            </div>

            <EditForm Model="model" OnValidSubmit="PlaceOrder" class="mt-6 space-y-3">
                <DataAnnotationsValidator />
                <div>
                    <label class="block text-sm font-medium">Name</label>
                    <InputText @bind-Value="model.Name" class="w-full border border-forest/40 rounded-lg px-3 py-2" />
                    <ValidationMessage For="() => model.Name" class="text-sm text-red-600" />
                </div>
                <div>
                    <label class="block text-sm font-medium">Contact number</label>
                    <InputText @bind-Value="model.Contact" class="w-full border border-forest/40 rounded-lg px-3 py-2" />
                    <ValidationMessage For="() => model.Contact" class="text-sm text-red-600" />
                </div>
                <button type="submit" class="w-full bg-forest text-cream py-2 rounded-full font-semibold hover:opacity-90">Place order</button>
            </EditForm>
        </div>

        @if (Booking.Latest is { } b)
        {
            <p class="mt-4 text-sm bg-cream rounded-lg p-3">
                ☕ We'll have your order ready for your repair on <b>@b.Date.ToString("MMM d")</b> at <b>@b.TimeSlot</b>.
            </p>
        }

    </div>
}

@code {
    public class CheckoutModel
    {
        [Required(ErrorMessage = "Please enter your name.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Please enter your contact number.")]
        [MinLength(7, ErrorMessage = "Contact number is too short.")]
        public string Contact { get; set; } = "";
    }

    private CheckoutModel model = new();
    private bool orderPlaced;
    private string orderName = "";
    private decimal orderTotal;

    private void PlaceOrder()
    {
        orderName = model.Name;
        orderTotal = Cart.Total;
        Cart.Clear();
        orderPlaced = true;
    }
}