
@page "/"
@inject CartService Cart

<PageTitle>Byte &amp; Brew — Coffee, Tech &amp; Repair</PageTitle>

<section class="relative overflow-hidden rounded-[2rem] bg-[#eee0cf]">
    <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-copper/10 blur-3xl"></div>
    <div class="absolute -bottom-24 left-1/4 h-64 w-64 rounded-full bg-white/50 blur-3xl"></div>

    <div class="relative grid items-center gap-8 px-6 py-10 sm:px-10 sm:py-14 lg:grid-cols-2 lg:px-16 lg:py-20">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">Coffee meets technology</p>

            <h1 class="mt-5 text-5xl font-black leading-[1.05] tracking-tight text-ink sm:text-6xl lg:text-7xl">
                Your daily
                <span class="font-serif font-normal italic text-copper">brew.</span>
                Your next
                <span class="block">big idea.</span>
            </h1>

            <p class="mt-6 max-w-lg text-sm leading-7 text-ink/70 sm:text-base">
                Discover great coffee, shop everyday tech, and get your devices repaired in one welcoming space.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
                <a href="/cafe" class="inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 text-sm font-semibold text-cream transition hover:bg-copper">
                    Explore the café <span>→</span>
                </a>
                <a href="/gadgets" class="inline-flex items-center gap-2 rounded-full border border-ink/20 bg-white/60 px-6 py-3.5 text-sm font-semibold text-ink transition hover:bg-white">
                    Browse gadgets
                </a>
            </div>

            <div class="mt-10 grid max-w-md grid-cols-3 border-t border-ink/15 pt-6">
                @foreach (var s in stats)
                {
                    <div class="border-r border-ink/15 px-3 first:pl-0 last:border-0">
                        <p class="text-xl font-black text-ink sm:text-2xl">@s.Value</p>
                        <p class="mt-1 text-[10px] leading-4 text-ink/60 sm:text-xs">@s.Label</p>
                    </div>
                }
            </div>
        </div>

        <div class="relative mx-auto flex w-full max-w-lg items-center justify-center">
            <div class="absolute aspect-square w-[90%] rounded-full bg-white/40"></div>
            <div class="absolute aspect-square w-[75%] rounded-full border border-copper/20"></div>

            <div class="relative flex aspect-square w-full animate-float items-center justify-center">
                <span class="text-[9rem] drop-shadow-xl sm:text-[12rem]" aria-hidden="true">☕</span>
                <img src="images/hero.png"
                     alt="Byte &amp; Brew café"
                     onerror="this.style.display='none'"
                     class="absolute inset-0 h-full w-full object-contain p-6" />
            </div>

            <div class="absolute bottom-4 left-0 rounded-2xl border border-ink/5 bg-white/90 px-4 py-3 shadow-lg backdrop-blur sm:bottom-10">
                <p class="text-xs font-bold text-ink">Your neighborhood tech café</p>
                <p class="mt-1 text-[10px] text-ink/55">Sip. Shop. Repair.</p>
            </div>
        </div>
    </div>
</section>

<section class="py-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">Made for your day</p>
            <h2 class="mt-2 text-3xl font-black tracking-tight text-ink sm:text-4xl">Find your next favorite.</h2>
            <p class="mt-2 text-sm text-ink/60">A little caffeine, a little technology, a lot of possibilities.</p>
        </div>
        <a href="/cafe" class="text-sm font-bold text-copper transition hover:text-ink">Visit the café →</a>
    </div>

    <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var entry in Featured.Select((p, i) => new { p, i }))
{
    <ProductCard Item="entry.p" OnAdd="AddToCart" Delay="entry.i * 90" />
}
    </div>

    @if (lastAdded is not null)
    {
        <p role="status" aria-live="polite" class="mt-5 rounded-xl border border-forest/15 bg-white px-4 py-3 text-sm font-semibold text-forest">
            ✓ @lastAdded
        </p>
    }
</section>

<section class="grid gap-5 lg:grid-cols-2">
    <a href="/gadgets" class="group relative flex min-h-64 items-center justify-between gap-4 overflow-hidden rounded-3xl bg-[#e6e7dc] p-6 transition hover:shadow-lg sm:p-9">
        <div class="relative z-10 max-w-xs">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-forest">The tech shelf</p>
            <h2 class="mt-3 text-3xl font-black leading-tight text-ink">Small upgrades.<br />Big difference.</h2>
            <p class="mt-3 text-sm text-ink/65">Find gadgets and accessories for everyday life.</p>
            <span class="mt-5 inline-block text-sm font-bold text-copper">Shop gadgets →</span>
        </div>
        <span class="text-6xl transition-transform duration-300 group-hover:scale-110 sm:text-8xl" aria-hidden="true">🎧</span>
        <img src="images/banner.png"
             alt=""
             onerror="this.style.display='none'"
             class="absolute bottom-0 right-0 h-4/5 w-1/2 object-contain" />
    </a>

    <a href="/repair" class="group flex min-h-64 items-center justify-between gap-4 overflow-hidden rounded-3xl bg-ink p-6 text-cream transition hover:shadow-lg sm:p-9">
        <div class="max-w-xs">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-mint">Repair studio</p>
            <h2 class="mt-3 text-3xl font-black leading-tight">Let's get your<br />tech working.</h2>
            <p class="mt-3 text-sm text-cream/65">Book a repair and get your device back on track.</p>
            <span class="mt-5 inline-block text-sm font-bold text-mint">Book a repair →</span>
        </div>
        <span class="text-6xl transition-transform duration-300 group-hover:rotate-12 sm:text-8xl" aria-hidden="true">🔧</span>
    </a>
</section>

<section class="py-12">
    <div class="mx-auto max-w-2xl text-center">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">Why Byte &amp; Brew?</p>
        <h2 class="mt-3 text-3xl font-black tracking-tight text-ink sm:text-4xl">A better kind of break.</h2>
        <p class="mt-3 text-sm leading-6 text-ink/60">Good service, useful technology, and a place to slow down for a moment.</p>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        @foreach (var f in features)
        {
            <div class="rounded-2xl border border-ink/10 bg-white p-5 transition hover:-translate-y-1 hover:shadow-lg">
                <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-cream text-2xl">@f.Emoji</div>
                <h3 class="mt-4 font-bold text-ink">@f.Title</h3>
                <p class="mt-2 text-sm leading-6 text-ink/60">@f.Text</p>
            </div>
        }
    </div>
</section>

<section class="flex flex-col items-start justify-between gap-6 rounded-3xl bg-[#eee0cf] p-7 sm:flex-row sm:items-center sm:p-10">
    <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-copper">Make time for yourself</p>
        <h2 class="mt-3 text-3xl font-black text-ink">Coffee first. Everything else follows.</h2>
        <p class="mt-2 text-sm text-ink/65">Your next coffee break is just around the corner.</p>
    </div>
    <a href="/cafe" class="shrink-0 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-cream transition hover:bg-copper">
        Order a drink →
    </a>
</section>

@code {
    private record Stat(string Label, string Value);
    private record Feature(string Emoji, string Title, string Text);

    private readonly List<Stat> stats = new()
    {
        new("Products", "16+"),
        new("Repair services", "6"),
        new("Customer rating", "4.9★")
    };

    private readonly List<Feature> features = new()
    {
        new("☕", "Fresh daily", "Drinks and pastries made throughout the day."),
        new("🔧", "Skilled repairs", "Clear estimates before work begins."),
        new("🔌", "Everyday tech", "Useful gadgets and accessories for your setup."),
        new("⏱️", "Convenient service", "Coffee, shopping, and repairs in one place.")
    };

    private string? lastAdded;

    private IEnumerable<Product> Featured =>
        ProductData.All.Where(p => p.Category == "Drinks").Take(2)
            .Concat(ProductData.All.Where(p => p.Category == "Gadgets").Take(2));

    private void AddToCart(Product p)
    {
        Cart.Add(p);
        lastAdded = $"{p.Name} added to cart";
    }
}
