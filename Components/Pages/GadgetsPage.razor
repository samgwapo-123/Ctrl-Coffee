@page "/gadgets"
@inject CartService Cart

<PageTitle>Gadgets – Byte &amp; Brew</PageTitle>

<section class="rounded-3xl bg-ink text-cream p-8 sm:p-10">
    <p class="font-mono text-xs tracking-widest text-mint">— GADGET SHOP</p>
    <h1 class="mt-2 text-4xl font-bold">Gadgets &amp; <span class="font-serif italic text-mint">accessories</span></h1>
    <p class="mt-2 text-cream/70 max-w-xl">Pick up something new while your device is being repaired.</p>
</section>

<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    <input @bind="search" @bind:event="oninput" placeholder="Search gadgets..."
           class="border border-forest/40 rounded-full px-4 py-2 bg-white w-full sm:w-72" />
    @if (lastAdded is not null)
    {
        <p class="text-sm font-semibold text-copper">@lastAdded</p>
    }
</div>

<div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    @foreach (var p in Items)
    {
        <ProductCard Item="p" OnAdd="AddToCart" />
    }
</div>

@if (!Items.Any())
{
    <p class="mt-8 text-center text-forest/70">No gadgets found.</p>
}

@code {
    private string search = "";
    private string? lastAdded;

    private IEnumerable<Product> Items => ProductData.All.Where(p =>
        p.Category == "Gadgets" && p.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

    private void AddToCart(Product p)
    {
        Cart.Add(p);
        lastAdded = $"✓ {p.Name} added to cart";
    }
}