@page "/gadgets"
@inject CartService Cart

<PageTitle>Gadgets – Byte &amp; Brew</PageTitle>

<PageHeader Label="The tech shelf" Title="Small upgrades." Accent="Big difference."
            Text="Pick up something new while your device is being repaired."
            Image="images/gadgets-hero.jpg" Emoji="🎧"
            ButtonText="Shop gadgets" ButtonHref="#products" />

<div id="products" class="mt-12 scroll-mt-28">
    <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">Everyday tech</p>
    <h2 class="mt-2 text-3xl font-black tracking-tight text-ink sm:text-4xl">
        Gadgets &amp; <span class="font-serif font-normal italic text-copper">accessories</span>
    </h2>
</div>

<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    <input @bind="search" @bind:event="oninput" placeholder="Search gadgets..."
           class="w-full rounded-full border border-ink/15 bg-white px-5 py-2.5 text-sm transition focus:border-copper focus:outline-none focus:ring-2 focus:ring-copper/20 sm:w-72" />

    @if (lastAdded is not null)
    {
        <p role="status" class="animate-pop rounded-full bg-white px-4 py-2 text-sm font-semibold text-forest shadow-sm">✓ @lastAdded</p>
    }
</div>

<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    @foreach (var entry in Items.Select((p, i) => new { p, i }))
    {
        <ProductCard @key="entry.p.Id" Item="entry.p" OnAdd="AddToCart" Delay="entry.i * 70" />
    }
</div>

@if (!Items.Any())
{
    <p class="mt-10 text-center text-ink/60">No gadgets found.</p>
}

@code {
    private string search = "";
    private string? lastAdded;

    private IEnumerable<Product> Items => ProductData.All.Where(p =>
        p.Category == "Gadgets" && p.Name.Contains(search, StringComparison.OrdinalIgnoreCase));

    private void AddToCart(Product p)
    {
        Cart.Add(p);
        lastAdded = $"{p.Name} added to cart";
    }
}