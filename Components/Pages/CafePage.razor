@page "/cafe"
@inject CartService Cart
@inject BookingService Booking

<PageTitle>Café — Byte &amp; Brew</PageTitle>

<section class="overflow-hidden rounded-[2rem] bg-[#eee0cf]">
    <div class="grid items-center gap-6 px-6 py-9 sm:px-10 sm:py-12 lg:grid-cols-[1.2fr_0.8fr] lg:px-14">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">The café menu</p>
            <h1 class="mt-4 text-4xl font-black leading-tight tracking-tight text-ink sm:text-5xl">
                A little coffee.
                <span class="block font-serif font-normal italic text-copper">A lot of comfort.</span>
            </h1>
            <p class="mt-4 max-w-lg text-sm leading-7 text-ink/70">
                Fresh drinks and pastries to brighten your day, whether you're taking a break or waiting for a repair.
            </p>
            <a href="#menu" class="mt-7 inline-flex rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-cream transition hover:bg-copper">
                Explore the menu →
            </a>
        </div>

        <div class="relative mx-auto flex aspect-square w-full max-w-sm items-center justify-center rounded-full border border-copper/20 bg-white/35">
            <div class="absolute inset-5 rounded-full border border-copper/20"></div>
            <div class="absolute inset-10 rounded-full border border-copper/20"></div>
            <span class="text-8xl sm:text-9xl" aria-hidden="true">☕</span>
        </div>
    </div>
</section>

@if (Booking.Latest is { } b)
{
    <div role="status" class="mt-6 flex gap-4 rounded-2xl border border-forest/15 bg-white p-5">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#e3eddf] text-xl" aria-hidden="true">✓</span>
        <div>
            <h2 class="font-bold text-ink">Your repair is booked</h2>
            <p class="mt-1 text-sm leading-6 text-ink/70">
                Reference <strong>@b.Reference</strong> · @b.Date.ToString("MMM d") at @b.TimeSlot.
                Order a drink to enjoy while you wait.
            </p>
        </div>
    </div>
}

<section id="menu" class="py-10">
    <div>
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">Made fresh for you</p>
        <h2 class="mt-2 text-3xl font-black tracking-tight text-ink sm:text-4xl">What's on the menu?</h2>
        <p class="mt-2 text-sm text-ink/60">Find your favorite drink or pair it with something sweet.</p>
    </div>

    <div class="mt-6 flex flex-wrap gap-2" aria-label="Filter café products">
        @foreach (var c in categories)
        {
            <button type="button"
                    @onclick="() => selected = c"
                    aria-pressed="@(selected == c)"
                    class="rounded-full border px-5 py-2.5 text-sm font-semibold transition @(selected == c ? "border-ink bg-ink text-cream" : "border-ink/15 bg-white text-ink/70 hover:border-copper hover:text-copper")">
                @c
            </button>
        }
    </div>

    @if (lastAdded is not null)
    {
        <div role="status" aria-live="polite" class="mt-5 rounded-xl border border-forest/15 bg-white px-4 py-3 text-sm font-semibold text-forest">
            ✓ @lastAdded
        </div>
    }

    @if (Items.Any())
    {
        <div class="mt-7 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            @foreach (var p in Items)
            {
                <ProductCard Item="p" OnAdd="AddToCart" />
            }
        </div>
    }
    else
    {
        <div class="mt-7 rounded-2xl border border-dashed border-ink/20 bg-white/60 px-5 py-12 text-center">
            <p class="text-4xl" aria-hidden="true">☕</p>
            <h3 class="mt-3 text-lg font-bold text-ink">Nothing on the menu yet</h3>
            <p class="mt-2 text-sm text-ink/60">Try another category.</p>
        </div>
    }
</section>

<section class="flex flex-col items-start justify-between gap-5 rounded-3xl bg-ink p-6 text-cream sm:flex-row sm:items-center sm:p-8">
    <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-mint">More to discover</p>
        <h2 class="mt-2 text-2xl font-black">Looking for your next gadget?</h2>
        <p class="mt-2 text-sm text-cream/65">Explore our gadgets and accessories.</p>
    </div>
    <a href="/gadgets" class="shrink-0 rounded-full bg-mint px-6 py-3 text-sm font-bold text-ink transition hover:bg-white">
        Explore gadgets →
    </a>
</section>

@code {
    private readonly string[] categories = { "All", "Drinks", "Pastries" };

    private string selected = "All";
    private string? lastAdded;

    private IEnumerable<Product> Items => ProductData.All.Where(p =>
        p.Category != "Gadgets" &&
        (selected == "All" || p.Category == selected));

    private void AddToCart(Product p)
    {
        Cart.Add(p);
        lastAdded = $"{p.Name} added to cart";
    }
}
