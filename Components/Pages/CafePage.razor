@page "/cafe"
@inject CartService Cart
@inject BookingService Booking

<PageTitle>Café – Byte &amp; Brew</PageTitle>

<PageHeader Label="The café menu" Title="A little coffee." Accent="A lot of comfort."
            Text="Fresh drinks and pastries to brighten your day, whether you're taking a break or waiting for a repair."
            Image="images/cafe-hero.avif" Emoji="☕"
            ButtonText="Explore the menu" ButtonHref="#menu" />

@if (Booking.Latest is { } b)
{
    <div class="mt-6 animate-fade-up rounded-2xl border border-copper/30 bg-mint/30 p-4 text-sm">
        🔧 Your repair <b>@b.Reference</b> is booked for <b>@b.Date.ToString("MMM d")</b> at <b>@b.TimeSlot</b>.
        Order a drink now and we'll have it ready for you.
    </div>
}

<div id="menu" class="mt-12 scroll-mt-28">
    <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">Made fresh for you</p>
    <h2 class="mt-2 text-3xl font-black tracking-tight text-ink sm:text-4xl">
        Drinks &amp; <span class="font-serif font-normal italic text-copper">bites</span>
    </h2>
</div>

<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
    <div class="flex flex-wrap gap-2">
        @foreach (var c in categories)
        {
            <button type="button" @onclick="() => selected = c"
                    class="rounded-full border px-5 py-2 text-sm font-semibold transition active:scale-95 @(selected == c ? "border-ink bg-ink text-cream" : "border-ink/15 bg-white hover:border-copper hover:text-copper")">
                @c
            </button>
        }
    </div>

    @if (lastAdded is not null)
    {
        <p role="status" class="animate-pop rounded-full bg-white px-4 py-2 text-sm font-semibold text-forest shadow-sm">✓ @lastAdded</p>
    }
</div>

<div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    @foreach (var entry in Items.Select((p, i) => new { p, i }))
    {
        <ProductCard @key="entry.p.Id" Item="entry.p" OnAdd="AddToCart" Delay="entry.i * 70" />
    }
</div>

@code {
    private readonly string[] categories = { "All", "Drinks", "Pastries" };
    private string selected = "All";
    private string? lastAdded;

    private IEnumerable<Product> Items => ProductData.All.Where(p =>
        p.Category != "Gadgets" && (selected == "All" || p.Category == selected));

    private void AddToCart(Product p)
    {
        Cart.Add(p);
        lastAdded = $"{p.Name} added to cart";
    }
}