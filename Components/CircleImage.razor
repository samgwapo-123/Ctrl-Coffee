<div class="relative mx-auto flex w-full @MaxWidth items-center justify-center">
    <div class="absolute aspect-square w-[106%] rounded-full border border-copper/25"></div>
    <div class="absolute aspect-square w-[116%] rounded-full border border-copper/10"></div>

    <div class="relative aspect-square w-full overflow-hidden rounded-full border-8 border-white/70 bg-white/60 shadow-2xl shadow-ink/20 @(Float ? "animate-float" : "")">
        <span class="absolute inset-0 flex items-center justify-center text-8xl sm:text-9xl" aria-hidden="true">@Emoji</span>
        <img src="@Src" alt="@Alt" onerror="this.style.display='none'"
             class="absolute inset-0 h-full w-full object-cover" />
    </div>

    @ChildContent
</div>

@code {
    [Parameter] public string Src { get; set; } = "";
    [Parameter] public string Alt { get; set; } = "";
    [Parameter] public string Emoji { get; set; } = "";
    [Parameter] public string MaxWidth { get; set; } = "max-w-md";
    [Parameter] public bool Float { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}