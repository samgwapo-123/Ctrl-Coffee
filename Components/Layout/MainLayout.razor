@inherits LayoutComponentBase
@implements IDisposable
@inject CartService Cart

<div class="min-h-screen flex flex-col bg-cream text-ink">
    <header class="sticky top-0 z-40 border-b border-ink/10 bg-cream/95 backdrop-blur-md">
        <div class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
            <a href="/" class="flex items-center gap-3" aria-label="Byte and Brew home">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-ink text-xl text-cream">☕</span>
                <span>
                    <span class="block text-lg font-black tracking-tight">Byte &amp; Brew</span>
                    <span class="block text-[10px] font-semibold uppercase tracking-[0.2em] text-ink/50">Coffee · Tech · Repair</span>
                </span>
            </a>

            <nav class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium" aria-label="Main navigation">
                <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" ActiveClass="nav-link-active">Home</NavLink>
                <NavLink href="/cafe" class="nav-link" ActiveClass="nav-link-active">Café</NavLink>
                <NavLink href="/gadgets" class="nav-link" ActiveClass="nav-link-active">Gadgets</NavLink>
                <NavLink href="/repair" class="nav-link" ActiveClass="nav-link-active">Repair</NavLink>
            </nav>

            <div class="flex items-center gap-2">
                <a href="/cart" class="inline-flex items-center gap-2 rounded-full border border-ink/15 bg-white px-4 py-2.5 text-sm font-semibold transition hover:border-copper hover:text-copper">
                    <span aria-hidden="true">🛒</span>
                    <span>Cart</span>
                    <span @key="Cart.Count" class="flex h-6 min-w-6 animate-pop items-center justify-center rounded-full bg-cream px-1.5 text-xs">@Cart.Count</span>
                </a>
                <a href="/repair" class="hidden rounded-full bg-ink px-5 py-3 text-sm font-semibold text-cream transition hover:bg-copper sm:inline-flex">
                    Book a repair →
                </a>
            </div>
        </div>
    </header>

    <main class="mx-auto w-full max-w-7xl flex-1 px-4 py-7 sm:px-6 sm:py-10 lg:px-8">
        @Body
    </main>

    <footer class="mt-auto bg-ink text-cream">
        <div class="mx-auto grid w-full max-w-7xl gap-8 px-4 py-10 sm:grid-cols-2 sm:px-6 lg:grid-cols-3 lg:px-8">
            <div>
                <a href="/" class="text-xl font-black tracking-tight">Byte &amp; Brew<span class="text-mint">.</span></a>
                <p class="mt-3 max-w-xs text-sm leading-6 text-cream/65">
                    Good coffee. Better connections. Your neighborhood spot for coffee, gadgets, and repairs.
                </p>
            </div>

            <div>
                <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-mint">Explore</h2>
                <div class="mt-4 flex flex-col items-start gap-3 text-sm text-cream/70">
                    <a href="/cafe" class="transition hover:text-white">Our café</a>
                    <a href="/gadgets" class="transition hover:text-white">Gadgets &amp; accessories</a>
                    <a href="/repair" class="transition hover:text-white">Repair services</a>
                </div>
            </div>

            <div>
                <h2 class="text-xs font-bold uppercase tracking-[0.2em] text-mint">Need a hand?</h2>
                <p class="mt-4 text-sm leading-6 text-cream/65">Have a device that needs attention?</p>
                <a href="/repair" class="mt-3 inline-flex rounded-full border border-cream/25 px-4 py-2.5 text-sm font-semibold transition hover:bg-cream hover:text-ink">
                    Book a repair →
                </a>
            </div>
        </div>

        <div class="border-t border-cream/10 px-4 py-5 text-center text-xs text-cream/50">
            © 2026 Byte &amp; Brew. All rights reserved.
        </div>
    </footer>
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 z-50 hidden bg-red-700 p-4 text-white">
    An unexpected error occurred.
    <a href="" class="ml-2 underline">Reload</a>
    <button type="button" class="dismiss float-right" aria-label="Dismiss error">✕</button>
</div>

@code {
    protected override void OnInitialized()
    {
        Cart.OnChange += HandleCartChange;
    }

    private void HandleCartChange()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Cart.OnChange -= HandleCartChange;
    }
}
