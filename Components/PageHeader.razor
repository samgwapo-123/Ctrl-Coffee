<section class="animate-fade-up overflow-hidden rounded-3xl bg-[#eee0cf]">
    <div class="grid items-center gap-6 px-6 py-10 sm:px-10 md:grid-cols-2">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.25em] text-copper">@Label</p>
            <h1 class="mt-3 text-4xl font-black tracking-tight text-ink sm:text-5xl">
                @Title <span class="font-serif font-normal italic text-copper">@Accent</span>
            </h1>
            <p class="mt-3 max-w-md text-sm leading-6 text-ink/70">@Text</p>
        </div>

        <div class="relative hidden h-48 items-center justify-center overflow-hidden rounded-2xl bg-white/50 text-7xl md:flex">
            <span aria-hidden="true">@Emoji</span>
            <img src="@Image" alt="" onerror="this.style.display='none'"
                 class="absolute inset-0 h-full w-full object-cover" />
        </div>
    </div>
</section>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Accent { get; set; } = "";
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string Image { get; set; } = "";
    [Parameter] public string Emoji { get; set; } = "";
}